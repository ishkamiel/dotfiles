#{{ template "install_helpers.sh" . }}

if [[ "{{ .chezmoi.os }}" != "windows" ]]; then
  echo "Skipping winget install on {{ .chezmoi.os }}"
  exit 0
fi

if ! command -v winget >/dev/null 2>&1; then
  log_error "winget not available; install App Installer from Microsoft Store and rerun."
  exit 1
fi

packages=()
packages+=(
  Git.Git
  Neovim.Neovim
  Starship.Starship
  sharkdp.fd
  sharkdp.bat
  BurntSushi.ripgrep.MSVC
  junegunn.fzf
  eza-community.eza
  Microsoft.WindowsTerminal
)
install_winget_pkgs "${packages[@]}"

optional_packages=(
  Python.Python.3.12
  Gerardog.gsudo
)
install_winget_pkgs_noerr "${optional_packages[@]}"

