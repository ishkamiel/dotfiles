{
	"folders": [
		{
			"path": "../../../d/llvm/llvm"
		}
	],
	"settings": {
		"peacock.color": "#7ae0fc",
		"cmake.configureArgs": [
			"-DLLVM_EXTERNAL_PROJECTS:STRING=SVF",
			"-DLLVM_EXTERNAL_SVF_SOURCE_DIR:FILEPATH=${env:HOME}/d/SVF",
			"-DCMAKE_INSTALL_PREFIX:FILEPATH=${env:HOME}/opt/llvm/dpp",
			"-DLLVM_TARGETS_TO_BUILD:STRING=",
			"-DLLVM_ENABLE_PROJECTS:STRING=clang",
			"-DLLVM_CCACHE_BUILD:BOOL=On",
			"-DLLVM_OPTIMIZED_TABLEGEN:BOOL=On",
			"-DCMAKE_CXX_STANDARD:STRING=17",
			"-DBUILD_SHARED_LIBS:BOOL=Off",
			"-DLLVM_BUILD_TOOLS:BOOL=Off"
		],
		"cmake.buildDirectory": "${env:HOME}/d/llvm/build/dpp",
		"C_Cpp.default.cppStandard": "c++17",
		"C_Cpp.default.cStandard": "c17",
		"cmake.statusbar.visibility": "compact",
		"workbench.colorCustomizations": {
			"activityBar.activeBackground": "#acecfd",
			"activityBar.activeBorder": "#fb63db",
			"activityBar.background": "#acecfd",
			"activityBar.foreground": "#15202b",
			"activityBar.inactiveForeground": "#15202b99",
			"activityBarBadge.background": "#fb63db",
			"activityBarBadge.foreground": "#15202b",
			"statusBar.background": "#7ae0fc",
			"statusBar.foreground": "#15202b",
			"statusBarItem.hoverBackground": "#48d4fb",
			"titleBar.activeBackground": "#7ae0fc",
			"titleBar.activeForeground": "#15202b",
			"titleBar.inactiveBackground": "#7ae0fc99",
			"titleBar.inactiveForeground": "#15202b99"
		},
	}
}
