export DEFAULT_USER=ishkamiel
export DOTFILES="${HOME}/.dotfiles"
export ZSH="${HOME}/.oh-my-zsh"
export ZSH_CUSTOM="${HOME}/.config/omz-custom"

# Helper functions
__prepend_to_PATH() {
  case ":$PATH:" in
    *:"$1":*) ;;
    *) [[ -d "$1" ]] && export PATH="$1:${PATH}" ;;
  esac
}

# Update here (in addition to ~/.profile)
__prepend_to_PATH "${HOME}/bin"
__prepend_to_PATH "${HOME}/.local/bin"
__prepend_to_PATH "${HOME}/.cargo/bin"
__prepend_to_PATH "${HOME}/go/bin"
__prepend_to_PATH "/opt/homebrew/bin"

# Configure history
export HISTFILE="${HOME}/.zhistory"
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt HIST_IGNORE_SPACE
setopt HIST_IGNORE_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS
# shellcheck disable=SC2034
HISTSIZE=10000
# shellcheck disable=SC2034
SAVEHIST=10000

# shellcheck disable=SC2034
DISABLE_MAGIC_FUNCTIONS=true
# shellcheck disable=SC2034
ZLE_RPROMPT_INDENT=0 # Fix for prompt issues

export GOPATH="${HOME}/go" # Set go home

# Load some local overrides, if they exist
# shellcheck disable=SC1090,SC1091
[[ -e "${HOME}/.zshrc_local" ]] && source "${HOME}/.zshrc_local"

####### vi mode ################################################################
bindkey -v
bindkey '^?' backward-delete-char
# shellcheck disable=SC2034
VI_MODE_SET_CURSOR=true
# shellcheck disable=SC2034
VI_MODE_RESET_PROMPT_ON_MODE_CHANGE=true

####### oh-my-zsh ##############################################################
zstyle ':omz:update' mode disabled

# shellcheck disable=SC2034
plugins=(
  command-not-found
  direnv
  fnm
  gitignore
  pyenv
  rust
  ssh-agent
  vi-mode
)

# shellcheck disable=SC1090,SC1091
source "$ZSH/oh-my-zsh.sh"

command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"

####### fzf ####################################################################
# --- Zsh Core Options ----------------
setopt AUTO_PARAM_SLASH
# --- Base settings -------------------
zstyle ':completion:*' matcher-list '' 'l:|=* r:|=*' 'm:{a-z}={A-Z}' 'r:|[._-]=* r:|=*'
zstyle ':completion:*' accept-exact-dirs true
zstyle ':completion:*' menu select
# --- Visuals and sorting -------------
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:descriptions' format '[%d]'
# shellcheck disable=SC2296,SC2086
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
# --- fzf for history -----------------
# Source fzf's keybindings here too (zprofile only runs for login shells), so
# fzf-history-widget exists in non-login interactive shells (e.g. inside tmux).
command -v fzf >/dev/null 2>&1 && eval "$(fzf --zsh)"
bindkey '^R' fzf-history-widget

####### aliases ################################################################
alias gl="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --color"
alias git-dc="git diff --color-words --color"
alias cp="cp -i"
alias rm="rm -i"
alias mv="mv -i"
# shellcheck disable=SC2139
alias makej="make -j${NPROC}"
alias doitj="doit -n${NPROC}"
# shellcheck disable=SC2139
alias umakej="unbuffer make -j${NPROC}"
alias udoitj="unbuffer doit -n${NPROC}"
alias whatsmyip="dig +short myip.opendns.com @resolver1.opendns.com"
# --- bat/batcat ----------------------
# Use `bcat` rather than shadowing `cat` so scripts that pipe into cat keep working.
if command -v batcat >/dev/null 2>&1; then
  alias bcat='batcat -p'
  export PAGER="batcat -p"
elif command -v bat >/dev/null 2>&1; then
  alias bcat='bat -p'
  export PAGER="bat -p"
fi
# --- nvim ----------------------------
command -v nvim >/dev/null 2>&1 && alias vim=nvim
# --- dust ----------------------------
command -v dust >/dev/null 2>&1 && alias du="dust"
# --- eza -----------------------------
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --git'
  alias ll='eza -l --git'
  alias la='eza -la --git'
  alias tree='eza --tree --color=always'
fi

export ANTHROPIC_MODEL=opusplan

command -v ishfiles >/dev/null 2>&1 && eval "$(ishfiles init --zsh)"

