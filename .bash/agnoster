# vim: ft=sh

# This is originally based on agnoster's Theme for ZSH [1], upon which Kenny Root [2] did some
# modifications to adapt it to bash. Although this is a somewhat heavily modified version...
#
# [1] https://gist.github.com/3712874
# [2] https://gist.github.com/kruton/8345450

CURRENT_BG='NONE'
SEGMENT_SEPARATOR='\ue0b0'
VC_UNCOM="✚"
VC_UNSTA=$(echo -e "\u25cf") #  ●
VC_UNTRA=$(echo -e "\u25cb") #
VC_SYMBOL=""

#VC_UNSTA="●"
#ZSH_THEME_GIT_PROMPT_DIRTY='±'

text_effect() {
    case "$1" in
        reset)     echo 0;;
        bold)      echo 1;;
        underline) echo 4;;
    esac
}

fg_color() {
    case "$1" in
        black)   echo 30;;
        red)     echo 31;;
        green)   echo 32;;
        yellow)  echo 33;;
        blue)    echo 34;;
        magenta) echo 35;;
        cyan)    echo 36;;
        white)   echo 37;;
    esac
}

bg_color() {
    case "$1" in
        black)   echo 40;;
        red)     echo 41;;
        green)   echo 42;;
        yellow)  echo 43;;
        blue)    echo 44;;
        magenta) echo 45;;
        cyan)    echo 46;;
        white)   echo 47;;
    esac;
}

ansi() {
    local seq
    declare -a thecodes=("${!1}")

    seq=""
    for ((i = 0; i < ${#thecodes[@]}; i++)); do
        if [[ -n $seq ]]; then
            seq="${seq};"
        fi
        seq="${seq}${thecodes[$i]}"
    done
    echo -ne "\[\033[${seq}m\]"
}

ansi_single() {
    echo -ne "\[\033[${1}m\]"
}

RESET="$(ansi_single $(text_effect reset))";

prompt_segment() {
    # Begin a segment. Takes two arguments, background and foreground. Both can be omitted,
    # rendering default background/foreground.
    local bg fg

    declare -a codes=($(fg_color $1) $(bg_color $2))

    if [[ -z $1 || ( -z $2 && $2 != default ) ]]; then
        codes=("${codes[@]}" $(text_effect reset))
    fi

    if [[ -n $2 ]]; then
        fg=$(fg_color $2)
        codes=("${codes[@]}" $fg)
    fi

    if [ -n "$1" ]; then
        bg=$(bg_color $1)
        codes=("${codes[@]}" $bg)
    fi

    if [[ $CURRENT_BG != NONE && $1 != $CURRENT_BG ]]; then
        declare -a intermediate=($(fg_color $CURRENT_BG) $(bg_color $1))
        echo -ne "$(ansi intermediate[@])${SEGMENT_SEPARATOR}"
    fi
    echo -ne "$(ansi codes[@])"

    [ -n "${3}" ] && echo -ne "$3"
    CURRENT_BG=$1
}

### Prompt components
# Each component will draw itself, and hide itself if no information needs to be shown

# Context: user@hostname (who am I and where am I)
prompt_context() {
    local user=`whoami`

    if [[ $user != $DEFAULT_USER || -n $SSH_CLIENT ]]; then
        prompt_segment cyan black "$user@$(hostname)"
    fi
}

# Git: branch/detached head, dirty status
prompt_git() {
    local symbol_repo=""

    if $(git rev-parse --is-inside-work-tree >/dev/null 2>&1); then
        # local status=""
        local s_uncom=
        local d_unsta=
        local d_untra=
        local branch=
        IFS=''
        while read line; do
            re_first='^##[[:space:]](.+)\.\.\.'
            if [[ "${line}" =~ ${re_first} ]]; then
                branch=${BASH_REMATCH[1]}
                [[ "${line}" =~ "ahead" ]] && ahead=1
            elif [[ "${line}" =~ ^\?\? ]]; then
                >&2 echo "untracked: $line"
                d_untra=1
            elif [[ "${line}" =~ ^.[[:alpha:]] ]]; then
                d_unsta=1
            elif [[ "${line}" =~ ^[[:alpha:]][[:space:]] ]]; then
                d_uncom=1
            else
                >&2 echo "_prompt_git: ${line}"
            fi
        done < <(git status -sb)
        unset IFS

        if [ -n "${d_unsta}" ] || [ -n "${d_untra}" ] || [ -n "${d_uncom}" ]; then
            prompt_segment magenta black
        else
            prompt_segment green black
        fi

        echo -n " ${VC_SYMBOL} ${branch} "
        [ -n "${d_untra}" ] && echo -n "${VC_UNTRA}"
        [ -n "${d_unsta}" ] && echo -n "${VC_UNSTA}"
        [ -n "${d_uncom}" ] && echo -n "${VC_UNCOM}"
    fi
}

# Dir: current working directory
prompt_dir() {
    prompt_segment blue black

    echo -ne $(pwd | sed "s|^$HOME|~|" | awk -F '/' '{
        i=1;
        while (i < NF) {
            if (length($i) > 4) {
                printf "%s../", substr($i, 1, 2);
            }
            else {
                printf "%s/", $i;
            }
            ++i;
        }
        printf "%s\n", $i;
    }')
}

# Status:
# - was there an error
# - am I root
# - are there background jobs?
prompt_status() {
    local symbols
    symbols=()
    [[ $RETVAL -ne 0 ]] && symbols+="$(ansi_single $(fg_color red))✘"
    [[ $UID -eq 0 ]] && symbols+="$(ansi_single $(fg_color yellow))⚡"
    [[ $(jobs -l | wc -l) -gt 0 ]] && symbols+="$(ansi_single $(fg_color cyan))⚙"
    [[ -n "$symbols" ]] && prompt_segment black default " $symbols "
}

# End the prompt, closing any open segments
prompt_end() {
    if [ -n "${CURRENT_BG}" ]; then
        declare -a codes=($(text_effect reset) $(fg_color $CURRENT_BG))
        echo -ne " $(ansi codes[@])${SEGMENT_SEPARATOR}"
    fi
    CURRENT_BG=''
}

_build_prompt() {
    CURRENT_BG='black'
    prompt_status
    prompt_context
    prompt_dir
    prompt_git
    prompt_end
}


## Main prompt
build_prompt() {
    RETVAL=$?

    export PS1="${RESET}$(_build_prompt) ${RESET}"
}

PROMPT_COMMAND=build_prompt
