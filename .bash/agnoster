# vim: ft=sh

# This is originally based on agnoster's Theme for ZSH
#   https://gist.github.com/3712874
# and further based on a bash conversion by Kenny Root
#   https://gist.github.com/kruton/8345450

CURRENT_BG='NONE'
SEGMENT_SEPARATOR='\ue0b0'

text_effect() {
  case "$1" in
    reset)     echo 0;;
    bold)      echo 1;;
    underline) echo 4;;
  esac
}

fg_color() {
  case "$1" in
    black)   echo 30;;
    red)     echo 31;;
    green)   echo 32;;
    yellow)  echo 33;;
    blue)    echo 34;;
    magenta) echo 35;;
    cyan)    echo 36;;
    white)   echo 37;;
  esac
}

bg_color() {
  case "$1" in
    black)   echo 40;;
    red)     echo 41;;
    green)   echo 42;;
    yellow)  echo 43;;
    blue)    echo 44;;
    magenta) echo 45;;
    cyan)    echo 46;;
    white)   echo 47;;
  esac;
}

ansi() {
  local seq
  declare -a thecodes=("${!1}")

  seq=""
  for ((i = 0; i < ${#thecodes[@]}; i++)); do
    if [[ -n $seq ]]; then
      seq="${seq};"
    fi
    seq="${seq}${thecodes[$i]}"
  done
  echo -ne "\033[${seq}m"
}

ansi_single() {
  echo -ne "\033[${1}m"
}

prompt_segment() {
    # Begin a segment. Takes two arguments, background and foreground. Both can be omitted,
    # rendering default background/foreground.
    local bg fg

    declare -a codes=($(fg_color $1) $(bg_color $2))

    if [[ -z $1 || ( -z $2 && $2 != default ) ]]; then
        codes=("${codes[@]}" $(text_effect reset))
    fi

    if [[ -n $2 ]]; then
        fg=$(fg_color $2)
        codes=("${codes[@]}" $fg)
    fi

    if [ -n "$1" ]; then
        bg=$(bg_color $1)
        codes=("${codes[@]}" $bg)
    fi

    if [[ $CURRENT_BG != NONE && $1 != $CURRENT_BG ]]; then
        declare -a intermediate=($(fg_color $CURRENT_BG) $(bg_color $1))
        echo -ne " $(ansi intermediate[@])${SEGMENT_SEPARATOR}"
    fi
    echo -ne "$(ansi codes[@])"

    [ -n "${3}" ] && echo -ne "$3"
    CURRENT_BG=$1
}

### Prompt components
# Each component will draw itself, and hide itself if no information needs to be shown

# Context: user@hostname (who am I and where am I)
prompt_context() {
    local user=`whoami`

    if [[ $user != $DEFAULT_USER || -n $SSH_CLIENT ]]; then
        prompt_segment cyan black "$user@$(hostname)"
    fi
}

git_status_dirty() {
    dirty=$(git status -s 2> /dev/null | tail -n 1)
    [[ -n $dirty ]] && echo "*"
}

# Git: branch/detached head, dirty status
_prompt_git() {
    local ref dirty
    local symbol_repo=""

    if $(git rev-parse --is-inside-work-tree >/dev/null 2>&1); then
        local status=""
        local s_uncom=
        local d_unsta=
        local d_untra=
        local branch=

        #ZSH_THEME_GIT_PROMPT_DIRTY='±'

        IFS=''
        while read line; do
            re_first='^##[[:space:]](.+)\.\.\.'
            if [[ "${line}" =~ ${re_first} ]]; then
                branch=${BASH_REMATCH[1]}
                [[ "${line}" =~ "ahead" ]] && ahead=1
            elif [[ "${line}" =~ ^\?\? ]]; then
                d_untra=1
            elif [[ "${line}" =~ ^.[[:alpha:]] ]]; then
                d_unsta=1
            elif [[ "${line}" =~ ^[[:alpha:]][[:space:]] ]]; then
                d_uncom=1
            else
                >&2 echo "_prompt_git: ${line}"
            fi
        done < <(git status -sb)
        unset IFS

        if [ -n "${d_unsta}" ] || [ -n "${d_untra}" ]; then
            status="${status}●"
        fi

        if [ -n "${d_uncom}" ]; then
            status="${status}✚"
        fi

        if [ -n "${d_unsta}" ] || [ -n "${d_untra}" ] || [ -n "${d_uncom}" ]; then
            prompt_segment magenta black
        else
            prompt_segment green black
        fi

        echo -n " ${symbol_repo} ${branch} ${status}"
    fi
}

# Dir: current working directory
prompt_dir() {
    prompt_segment blue black

    echo -ne " "$(pwd | sed "s|^$HOME|~|" | awk -F '/' '{
        i=1;
        while (i < NF) {
            if (length($i) > 4) {
                printf "%s../", substr($i, 1, 2);
            }
            else {
                printf "%s/", $i;
            }
            ++i;
        }
        printf "%s\n", $i;
    }')
}

# Status:
# - was there an error
# - am I root
# - are there background jobs?
prompt_status() {
    local symbols
    symbols=()
    [[ $RETVAL -ne 0 ]] && symbols+="$(ansi_single $(fg_color red))✘"
    [[ $UID -eq 0 ]] && symbols+="$(ansi_single $(fg_color yellow))⚡"
    [[ $(jobs -l | wc -l) -gt 0 ]] && symbols+="$(ansi_single $(fg_color cyan))⚙"

    [[ -n "$symbols" ]] && prompt_segment black default "$symbols"
}

# End the prompt, closing any open segments
prompt_end() {
    if [ -n "${CURRENT_BG}" ]; then
        declare -a codes=($(text_effect reset) $(fg_color $CURRENT_BG))
        echo -ne " $(ansi codes[@])${SEGMENT_SEPARATOR}"
    fi
    declare -a reset=($(text_effect reset))
    echo -ne " $(ansi reset[@])"
    CURRENT_BG=''
}

prompt_reset() {
    echo -ne "$(ansi_single $(text_effect reset))"
}

## Main prompt
build_prompt() {
    RETVAL=$?
    echo -ne "$(ansi_single $(text_effect reset))"
    prompt_status
    prompt_context
    prompt_dir
    _prompt_git
    prompt_end
}

#PS1="$(ansi_single $(text_effect reset))"'$(build_prompt)'
PS1='$(build_prompt)'
