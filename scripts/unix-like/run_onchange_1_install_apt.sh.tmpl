#{{ template "install_helpers.sh" . }}
#{{ template "install_helpers_apt.sh" . }}
#{{ template "install_helpers_snap.sh" . }}

packages=(
  git
  neovim
  tmux
  vim-nox
  zsh
#{{ if ne .machineType "min" }}
  apt-file
  aptitude
  btop
  curl
  dconf-cli
  eza
  fd-find
  fzf
  git-crypt
  ipython3
  locate
  shellcheck
  wget
#{{ if .needBuildTools }}
  autoconf
  automake
  build-essential
  ccache
  clang
  clang-format
  cmake
  direnv
  editorconfig
  exuberant-ctags
  flang
  g++
  gcc
  libcriticism-perl
  libxml2-dev
  lld
  llvm
  make
  markdown
  markdownlint
  ninja-build
  pkg-config
  pre-commit
  pylint
  python-is-python3
  rbenv
  rustup
#{{ end }}
#{{ end }}
)
apt_install "${packages[@]}"

packages=()
command -v starship >/dev/null 2>&1 || packages+=(starship)
#{{ if ne .machineType "min" }}
command -v batcat >/dev/null 2>&1 || packages+=(batcat)
command -v du >/dev/null 2>&1 || packages+=(du-dust)
#{{ end }}
apt_install 1 "${packages[@]}"

packages=()
#{{ if ne .machineType "min" }}
command -v tldr >/dev/null 2>&1 || packages+=(tldr)
#{{ end }}

snap_install "${packages[@]}"

