__prepend_to_PATH() {
    case ":$PATH:" in
        *:$1:*) ;;  # already in PATH
        *) [ -d "$1" ] && export PATH="$1:${PATH}" ;;
    esac
}

__prepend_to_MANPATH() {
    case ":$MANPATH:" in
        *:$1:*) ;;
        *) [ -d "$1" ] && export MANPATH="$1:${MANPATH}" ;;
    esac
}

__append_to_PATH() {
    case ":$PATH:" in
        *:$1:*) ;;
        *) [ -d "$1" ] && export PATH="${PATH}:$1" ;;
    esac
}

__prepend_to_PATH "${HOME}/bin"
__prepend_to_PATH "${HOME}/.local/bin"
__prepend_to_PATH "${HOME}/.cargo/bin"
__prepend_to_PATH "${HOME}/go/bin"
__prepend_to_PATH "/opt/homebrew/bin"

# Fix for intellj IDEs: https://youtrack.jetbrains.com/issue/IDEA-78860
export IBUS_ENABLE_SYNC_MODE=1


# Load .Xresources if we have xrdb and it exists
command -v xrdb >/dev/null 2>&1 && \
    [ -n "$XDG_SESSION_TYPE" ] && [ "$XDG_SESSION_TYPE" != "tty" ] &&\
    [ -e "${HOME}/.Xresources" ] && xrdb -merge "${HOME}/.Xresources"

export COLORTERM=truecolor

export PAGER="less -F"

# Configure vim and EDITOR
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
  alias vim=nvim
elif command -v vim >/dev/null 2>&1; then
  export EDITOR=vim
elif command -v vi >/dev/null 2>&1; then
  export EDITOR=vi
fi

# Load cargo environment
# shellcheck disable=SC1091
[ -e "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# shellcheck disable=SC1090 disable=SC1091
[ -e "${HOME}/.profile_local" ] && . "${HOME}/.profile_local"

