#!/bin/bash

# Just uncomment ths for a dry-run
# DRY_RUN='-n'

RSYNC_OPTS="-a"                             # archive mode; equals -rlptgoD (no -H,-A,-X)
RSYNC_OPTS="$RSYNC_OPTS -d"                 # transfer directories without recursing
RSYNC_OPTS="$RSYNC_OPTS -c"                 # skip based on checksum, not mod-time & size
RSYNC_OPTS="$RSYNC_OPTS -L"                 # transfrom symlink into referent file/dir
RSYNC_OPTS="$RSYNC_OPTS -R"                 # use relatvie path names
RSYNC_OPTS="$RSYNC_OPTS --delete-excluded"  # also deleet excluded files from dest dirs
# RSYNC_OPTS="$RSYNC_OPTS --cvs-exclude"      # auto-ignore files in the same way CVS does
RSYNC_OPTS="$RSYNC_OPTS --chmod=og-rwx"     # Apply chmod to dest files

RSYNC_OPTS="$RSYNC_OPTS -y"                 # increase verbosity
RSYNC_OPTS="$RSYNC_OPTS -h"                 # human readable
RSYNC_OPTS="$RSYNC_OPTS --progress"         # show progress during transfer

files=".dotfiles"
#files="$files .vim/bundle/Vundle.vim"

# Change to home directory, since we are using relative path names
cd $HOME

for host in "$@"; do
    rsync $DRY_RUN $RSYNC_OPTS -e ssh $files $host:
done
