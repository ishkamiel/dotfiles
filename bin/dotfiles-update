#! /usr/bin/env bash

set -euo pipefail

script_path=$(dirname "$(realpath -s "$0")")
dotfiles_path=$(cd "$script_path/.."; pwd)
export DOTFILES="${DOTFILES:="$dotfiles_path"}"

echo "script_path: $script_path"
echo "dotfiles_path: $dotfiles_path"
echo "DOTFILES: $DOTFILES"

# Collect missing commands here
need_to_install=()

# These are stow packages
stow_pkgs=(
  git
  zellij
)

check_command() {
	local command="$1"
	local apt_pkg="$2"

	if ! command -v "${command}" &> /dev/null; then
		need_to_install+=( "${apt_pkg}" )
	fi
}

run_script() {
	local script="${DOTFILES}/scripts/$1"
	echo "=== Running ${script}"
	"$script"
}

check_command stow stow
check_command git git

if [[ ${#need_to_install[@]} -ne 0 ]]; then
	echo "sudo apt-get install -y ${need_to_install[*]}"
	read -n 1 -s -r -p "Press any key to continue or Ctrl+C to abort..."
	echo
	sudo apt install -y "${need_to_install[@]}"
fi

pushd "${DOTFILES}"

git -C "${DOTFILES}" submodule update --init --recursive

# Restore separate stow pakckagers
for pkg in "${stow_pkgs[@]}"; do
  # Use grep to filter our verbose output
  stow --adopt -d "${DOTFILES}/stow_pkgs" -t "${HOME}/" "$pkg"
  git -C "${DOTFILES}" checkout "stow_pkgs/${pkg}"
  stow -R -d "${DOTFILES}/stow_pkgs" -t "${HOME}/" "$pkg" 2>&1 | grep -v 'BUG in find_stowed_path'
done

exit

stow_args=( --restow --target "${HOME}" . )
echo "=== Running stow ${stow_args[*]}"
stow "${stow_args[@]}"

run_script "oh-my-zsh.sh"
run_script "linux-apt_packages.sh"
run_script "vim-install-plugins.sh"
run_script "install_fzf.sh"

popd
