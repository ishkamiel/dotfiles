#! /usr/bin/env bash

set -euo pipefail

export DOTFILES="${DOTFILES:="${HOME}/.dotfiles"}"

stow_args=( --target "${HOME}" . )

pushd "${DOTFILES}"
./scripts/oh-my-zsh.sh
./scripts/vim-install-plugins.sh
./scripts/linux-apt_packages.sh
echo "=== Running stow ${stow_args[*]}"
stow "${stow_args[@]}"
popd
