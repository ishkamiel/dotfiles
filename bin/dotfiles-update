#! /usr/bin/env bash
# -*- coding: utf-8 -*-

set -euo pipefail

# Make sure DOTFILES is set, assume ~/.dotfiles if not
export DOTFILES=${DOTFILES:-"${HOME}/.dotfiles"}
export ISHLIB="${DOTFILES}/ishlib"

dotfilespy="${DOTFILES}/bin/dotfiles-update.py"
pyargs=""
pyversion=`cat "${DOTFILES}/.python-version"`

# export ISHLIB_DEBUG=1

if [[ ! -e ${ISHLIB}/ishlib.sh ]]; then
  git submodule update --init --recursive "${ISHLIB}"
fi

# shellcheck source=lib/installers.sh
. "${DOTFILES}/lib/installers.sh"
# shellcheck source=lib/ishlib.sh
. "${ISHLIB}/ishlib.sh"

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--debug)
      export DEBUG=1
      pyargs="${pyargs} --debug"
      shift
      ;;
    --ishlib-debug)
      export ISHLIB_DEBUG=1
      shift
      ;;
    -f|--force)
      export FORCE=1
      export FORCE_SUDO=1
      shift
      ;;
    -n|--dry-run)
      export DRY_RUN=1
      pyargs="${pyargs} --dry-run"
      shift
      ;;
    -v|--verbose)
      export VERBOSE=1
      pyargs="${pyargs} --verbose"
      shift
      ;;
    --init-only)
      INIT_ONLY=1
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      ish_warn "Invalid option: $1" >&2
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

# If needed, install deps for dotfiles-update.py
install_cmd_somehow "pyenv"
PYENV_ROOT="${HOME}/.pyenv"
PATH="${PYENV_ROOT}/bin:${PATH}"
eval "$(pyenv init -)"

pyenv install -s "${pyversion}"
pip3 install --upgrade pip

install_python_package_somehow "cerberus"
install_python_package_somehow "jsonschema"
install_python_package_somehow "pyyaml"

if [[ "${INIT_ONLY:=0}" == 1 ]]; then
  ish_debug "INIT_ONLY is set, exiting"
  exit 0
fi
ish_debug "Going to run: ish_run ${dotfilespy} ${pyargs}"
ish_run -f "${dotfilespy}" ${pyargs}

ish_debug "All done"
