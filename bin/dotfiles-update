#! /usr/bin/env bash
# -*- coding: utf-8 -*-

set -euo pipefail

# Make sure DOTFILES is set, assume ~/.dotfiles if not
export DOTFILES=${DOTFILES:-"${HOME}/.dotfiles"}

export ISHLIB="${DOTFILES}/ishlib"

# export ISHLIB_DEBUG=1

if [[ ! -e ${ISHLIB}/ishlib.sh ]]; then
  git submodule update --init --recursive "${ISHLIB}"
fi

# shellcheck source=lib/installers.sh
. "${DOTFILES}/lib/installers.sh"
# shellcheck source=lib/ishlib.sh
. "${ISHLIB}/ishlib.sh"

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--debug)
      export DEBUG=1
      pyargs+=("--debug")
      shift
      ;;
    --ishlib-debug)
      export ISHLIB_DEBUG=1
      shift
      ;;
    -f|--force)
      export FORCE=1
      export FORCE_SUDO=1
      shift
      ;;
    -n|--dry-run)
      export DRY_RUN=1
      pyargs+=("--dry-run")
      shift
      ;;
    -v|--verbose)
      export VERBOSE=1
      pyargs+=("--verbose")
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      ish_warn "Invalid option: $1" >&2
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

# Make sure we have some basic commands
install_cmd_somehow "python3"

# Install the following apt packages unless found
install_python_package_somehow "cerberus"

cmd=( "${DOTFILES}/bin/dotfiles-update.py" "${pyargs[@]}" )

ish_debug "Going to run: ish_run ${cmd[*]}"
ish_run -f "${cmd[@]}"

ish_debug "All done"
