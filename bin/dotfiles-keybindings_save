check_file() {
	local file=$1
	if [[ ! -e "${file}" ]]; then
		echo "Cannot find ${file}"
		exit;
	fi
	return 0
}

if [[ -z "${DOTFILES}" ]]; then
	DOTFILES=~/.dotfiles
	if [[ -e "${DOTFILES}" ]]; then
		echo "\${DOTFILES} not set, assuming default location (~/.dotfiles)"
		echo "\press Enter to continue, or ctrl-C to quit."
	else
		echo "\${DOTFILES} not set, cannot find dotfiles folder"
		exit
	fi
fi

KEY_BIN=${DOTFILES}/scripts/keybindings.pl
KEYFILE=${DOTFILES}/keybindings

check_file ${KEY_BIN}

echo "Saving current keybindings to ${KEYFILE}"
${KEY_BIN} -e ${KEYFILE}
