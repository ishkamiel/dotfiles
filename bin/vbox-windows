VMNAME=windows

if [[ ! "$(VBoxManage list vms)" =~  .*(^|\n)\"${VMNAME}\".* ]]; then # "
    m="Cannot find a VirtualBox vm named ${VMNAME}!"
    echo "${m}"
    notify-send "${m}"
    exit
fi

if [[ "$(VBoxManage list runningvms)" =~  .*(^|\n)\"${VMNAME}\".* ]]; then # "
    m="The ${VMNAME} vm is already running!"
    echo "${m}"
    notify-send "${m}"
    exit
fi

VBoxManage startvm "${VMNAME}"
