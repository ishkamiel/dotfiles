#!/bin/bash

# requires
# gawk, or other extended awk

CONKY_OPTS=""
CONKY_LOG="${TMPDIR}/log/conky"
CONF_DIR="${HOME}/.conky/configs"

if [ -z "${MY_CONKY_CONFIGS}" ]; then
	echo "Set MY_CONKY_CONFIG environmental variable before launching!"
	exit;
fi

CONFIGS=(${MY_CONKY_CONFIGS//;/ })

log() {
    if [ -z "${CONKY_LOG}" ]; then
        echo "${1}"
    else
        echo "${1}" \
            | awk '{ print strftime("%s: "), $0; fflush(); }'\
            >> "${CONKY_LOG}"
    fi
}

startOne() {
    local filename=${1}

    if [ -z "${CONKY_LOG}" ]; then
        conky "$CONKY_OPTS" -c "${filename}"
    else
        {(conky "$CONKY_OPTS" -c "${filename}" 2>&1 \
            | awk "{ print strftime(\"%s: $(basename ${filename}):\"), \$0; fflush(); }"\
            >> "${CONKY_LOG}") &}
    fi
}

startAll() {
    local host=$(hostname)

    for c in "${CONFIGS[@]}"; do
        fn="${CONF_DIR}/${c}"

        # Check for host specific config
        [ -e "${fn}_${host}" ] && fn="${fn}_${host}"

        log "starting $(basename ${fn})"
        startOne "${fn}"
        #sleep 1
    done
    log "startAll completed"
}

if [ -n "${CONKY_LOG}" ]; then
    # create the log directory unless it exists
    mkdir -p $(dirname "${CONKY_LOG}")
    # move old logfile
    [ -e "${CONKY_LOG}" ] && mv "${CONKY_LOG}" "${CONKY_LOG}.bak"
fi

startAll &
