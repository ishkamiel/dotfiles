{{- $machineType := promptString "Machine type (min/def/personal)" "def" -}}
{{- /* Validation Logic */ -}}
{{- if not (contains $machineType "min def personal") -}}
{{-   writeToStdout (printf "\nERROR: Invalid machine type '%s'\n" $machineType) -}}
{{-   exit 1 -}}
{{- end -}}

[diff]
    exclude = ["scripts"]
[data]
    email = "hans@liljestrand.dev"
    name = "Hans Liljestrand"
    machineType = {{ $machineType | quote }}
    isWork = {{ promptBoolOnce . "isWork" "Is this a work machine?" }}
    needBuildTools = {{ promptBoolOnce . "needBuildTools" "Should build tools be installed?" }}
