
! Xcursor -----------------------------------------------------------
Xcursor.theme: Adwaita
Xcursor.size:  22

! yahconsole --------------------------------------------------------
yeahconsole*toggleKey: Alt+section
yeahconsole*term: urxvtc
yeahconsole*faceName: Monospace:size=12:antialias=true
yeahconsole*consoleHeight: 20
yeahconsole*aniDelay: 10
yeahconsole*restart: 1

! xterm -------------------------------------------------------------
!xterm*faceName: Ubuntu Mono for Powerline:antialias=true
xterm*faceName: Monospace:antialias=true
xterm*faceSize: 11
xterm*termName: xterm-256color
xterm*saveLines: 4096
xterm*scrollBar: false
xterm*dynamicColors: true
xterm*utf8: 3

! rxvt-unicode ------------------------------------------------------
URxvt.font: xft:Ubuntu Mono:antialias=true:size=12
URxvt*saveLines: 1024
URxvt.scrollBar: false
URxvt*fading:  60
URxvt*visualBell: false
URxvt*termName:  screen-256color
! URxvt*perl-ext:
! URxvt*perl-ext-common:
URxvt.perl-ext-common: default,matcher
URxvt.url-launcher: /usr/bin/firefox
URxvt.matcher.button: 1
URxvt*background: #000000
URxvt*foreground: #d0d0d0
URxvt*cursorColor: #d0d0d0
