
snippet cl "class .. (class)"
class ${1:`!p snip.rv = snip.basename or "name"`}
{
public:
	${1/(\w+).*/$1/} (${2:arguments});
	virtual ~${1/(\w+).*/$1/} ();

protected:

private:
};
endsnippet

snippet ifndef "#ifndef ... #define ... #endif"
#ifndef ${1/([A-Za-z0-9_]+).*/$1/}
#define ${1:`!p snip.rv = snip.fn.upper().replace(".", "_")+"_" or "SYMBOL"`}

#endif /* ${1/([A-Za-z0-9_]+).*/$1/} */
endsnippet

# vim:ft=snippets:
