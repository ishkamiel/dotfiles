# ~/.profile: executed by the command interpreter for login shells.
# This file is not read by bash(1), if ~/.bash_profile or ~/.bash_login
# exists.
# see /usr/share/doc/bash/examples/startup-files for examples.
# the files are located in the bash-doc package.

# the default umask is set in /etc/profile; for setting the umask
# for ssh logins, install and configure the libpam-umask package.
#umask 022

# Locale settings
export LC_TIME=en_GB.UTF-8 # diaplsy dates (weekday/month names) in English

# Make CLion use system JRE
export CL_JDK=/usr/lib/jvm/java-8-oracle/jre

# Some extra paths
export PATH="$PATH:$HOME/personal/bin"
export PATH="$PATH:$HOME/.local/bin"

# Set editor
export EDITOR='/usr/bin/vim'

# SPARK
export SPARK_HOME=/home/ishkamiel/.local/opt/spark-1.6.0-bin-hadoop2.6    
export PATH=$PATH:$SPARK_HOME/bin   
export PYTHONPATH=$SPARK_HOME/python/:$PYTHONPATH   
export PYTHONPATH=$SPARK_HOME/python/lib/py4j-0.9-src.zip:$PYTHONPATH

# export NVM_DIR="$HOME/.nvm"
# if [ -s "$NVM_DIR/nvm.sh" ]; then
#     . "$NVM_DIR/nvm.sh"
#     nvm use 5
# fi

#export PD_XLOG="$HOME/.pd_xlog"
# LOG="$HOME/profile-invocations"
#echo $(date) "processing .profile >>$PD_XLOG
# echo "$(date) .profile - Caller: $0" >>$PD_XLOG
# echo "$(date) .profile - DESKTOP_SESSION: $DESKTOP_SESSION" >>$PD_XLOG
# echo "$(date) .profile - GDMSESSION: $GDMSESSION" >>$PD_XLOG

if [ -f "$HOME/.local_profile" ]; then
    . "$HOME/.local_profile"
fi

# Host specific stuff
if [ $(hostname) = 'thigreal' ]; then
    xrdb -merge ~/.Xresources.thigreal
    # xbacklight -set 70 &
    # synclient TouchpadOff=1 &
fi

# if running bash
if [ -n "$BASH_VERSION" ]; then
    # include .bashrc if it exists
    if [ -f "$HOME/.bashrc" ]; then
        . "$HOME/.bashrc"
    fi
fi

# Load Xresources
if [ "$0" = "/etc/gdm/Xsession" -o "$0" = "/usr/sbin/lightdm-session" ]; then
    xrdb -merge ~/.Xresources

    if [ $(hostname) = 'thigreal' ]; then
        xrdb -merge ~/.Xresources.thigreal
    fi

    if [ $(hostname) = 'ultreal' ]; then
        xrdb -merge ~/.Xresources.ultreal
    fi
fi


# i3 session
if [ "$0" = "/etc/gdm/Xsession" -a "$DESKTOP_SESSION" = "i3" -o "$DESKTOP_SESSION" = "i3-with-shmlog" ]; then
    export $(gnome-keyring-daemon --start --components=ssh,secrets,keyring,pkcs11)
fi

_byobu_sourced=1 . /usr/bin/byobu-launch 2>/dev/null || true
