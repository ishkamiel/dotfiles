# vim:fdm=marker foldlevel=0

# Make new files non-readable for others
umask 066

# Locale settings
# LANGUAGE=en_US
# export LANG=en_US.UTF-8
# LC_CTYPE="en_US.UTF-8"
# LC_COLLATE="en_US.UTF-8"
# LC_MESSAGES="en_US.UTF-8"
# export LC_TIME=en_GB.UTF-8 # GB for english names, but Finnish format
# LC_NUMERIC=fi_FI.UTF-8
# LC_MONETARY=fi_FI.UTF-8
# LC_PAPER=fi_FI.UTF-8
# LC_NAME=fi_FI.UTF-8
# LC_ADDRESS=fi_FI.UTF-8
# LC_TELEPHONE=fi_FI.UTF-8
# LC_MEASUREMENT=fi_FI.UTF-8
# LC_IDENTIFICATION=fi_FI.UTF-8

# Set editor
export EDITOR='/usr/bin/vim'

# Some extra PATHs {{{

if [ -e $HOME/.local/bin ]; then
    export PATH="$PATH:$HOME/.local/bin"
fi

if [ -e $HOME/personal/bin ]; then
    export PATH="$PATH:$HOME/personal/bin"
fi

# }}}

# Settings for Jetbrains IDEs {{{

# Make CLion use system JRE
export CL_JDK=/usr/lib/jvm/java-8-oracle/jre

# }}}

# Settings for Heroku {{{

HEROKU_BINDIR="/usr/local/heroku/bin"
if [ -e "$HEROKU_BINDIR" ]; then
    export PATH="$HEROKU_BINDIR:$PATH"
fi

# }}}

# Settings for Spark {{{

SPARK_HOME="$HOME/.local/opt/spark-1.6.0-bin-hadoop2.6"
if [ -e SPARK_HOME ]; then
    export SPARK_HOME
    export PATH=$PATH:$SPARK_HOME/bin
    export PYTHONPATH=$SPARK_HOME/python/:$PYTHONPATH
    export PYTHONPATH=$SPARK_HOME/python/lib/py4j-0.9-src.zip:$PYTHONPATH
fi

# }}}

# Some local startup stuff
if [ -f "$HOME/.local_profile" ]; then
    . "$HOME/.local_profile"
fi

# Load bashrc if running bash
if [ -n "$BASH_VERSION" ] && [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
