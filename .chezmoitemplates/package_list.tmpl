{{- /*
 SPDX-License-Identifier: MIT
 Copyright (C) 2026 Hans Liljestrand <hans@liljestrand.dev>

 Generates a list of package names for a given package manager, filtered by
 the current machine profile.  Designed to be called as a chezmoi template
 from within a bash packages=(...) or PowerShell @(...) array literal.

 Call with a dict:
   {{ template "package_list.tmpl" (dict "mgr" "apt" "optional" false "ctx" .) }}

 Parameters:
   mgr        - package manager key: "apt", "dnf", "brew", "cargo", or "winget"
   optional   - true = emit only optional packages; false = emit only required ones
   ctx        - the full chezmoi template context (pass ".")
   quote      - true = wrap each name in double quotes (for PowerShell arrays)
   gui_only   - true = emit only gui-only packages; false = emit non-gui-only packages
   gnome_only - true = emit only gnome-only packages; false = emit non-gnome-only packages

 Output: one indented package name per line, suitable for a bash or PS array literal.
*/ -}}
{{- $ctx        := .ctx -}}
{{- $mgr        := .mgr -}}
{{- $wantOpt    := not (not .optional) -}}
{{- $quote      := not (not (index . "quote")) -}}
{{- $guiOnly    := not (not (index . "gui_only")) -}}
{{- $gnomeOnly  := not (not (index . "gnome_only")) -}}
{{- range $name, $pkg := $ctx.packages -}}
{{-   $pkgName      := index $pkg $mgr -}}
{{-   $pkgOpt       := not (not (index $pkg "optional")) -}}
{{-   $pkgGuiOnly   := not (not (index $pkg "gui-only")) -}}
{{-   $pkgGnomeOnly := not (not (index $pkg "gnome-only")) -}}
{{-   $include := false -}}
{{-   if and $pkgName (eq $pkgOpt $wantOpt) (eq $pkgGuiOnly $guiOnly) (eq $pkgGnomeOnly $gnomeOnly) -}}
{{-     if index $pkg "min" -}}
{{-       $include = true -}}
{{-     else if and (index $pkg "build_tools") $ctx.needBuildTools (ne $ctx.machineType "min") -}}
{{-       $include = true -}}
{{-     else if and (index $pkg "work") $ctx.isWork (ne $ctx.machineType "min") -}}
{{-       $include = true -}}
{{-     else if and (index $pkg "gaming") $ctx.isGaming (ne $ctx.machineType "min") -}}
{{-       $include = true -}}
{{-     else if and (index $pkg "no_work") (not $ctx.isWork) (ne $ctx.machineType "min") -}}
{{-       $include = true -}}
{{-     else if and (index $pkg "personal") (eq $ctx.machineType "personal") -}}
{{-       $include = true -}}
{{-     else if and (not (index $pkg "build_tools")) (not (index $pkg "work")) (not (index $pkg "gaming")) (not (index $pkg "no_work")) (not (index $pkg "personal")) (ne $ctx.machineType "min") -}}
{{-       $include = true -}}
{{-     end -}}
{{-   end -}}
{{-   if $include }}
  {{ if $quote }}"{{ $pkgName }}"{{ else }}{{ $pkgName }}{{ end }}
{{-   end -}}
{{- end -}}
