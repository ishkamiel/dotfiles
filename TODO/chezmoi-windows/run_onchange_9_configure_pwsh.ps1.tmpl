# Make sure we run in PowerShell 7 or newer
if ($PSVersionTable.PSVersion.Major -lt 7) {
    if (Get-Command pwsh -ErrorAction SilentlyContinue) {
        pwsh -NoProfile -ExecutionPolicy Bypass -File "$PSCommandPath"
        exit $LASTEXITCODE
    } else {
        Write-Error "PowerShell 7 (pwsh) is required for this script but was not found."
        exit 1
    }
}

if (!(Test-Path $PROFILE)) { New-Item -Type File -Path $PROFILE -Force }
# Set the config file location
Set-Content $PROFILE ". '$HOME/.config/powershell/profile.ps1'"
