# Make sure we run in PowerShell 7 or newer
if ($PSVersionTable.PSVersion.Major -lt 7) {
    if (Get-Command pwsh -ErrorAction SilentlyContinue) {
        pwsh -NoProfile -ExecutionPolicy Bypass -File "$PSCommandPath"
        exit $LASTEXITCODE
    } else {
        Write-Error "PowerShell 7 (pwsh) is required for this script but was not found."
        exit 1
    }
}

{{ template "windows/install_helpers.ps1" . }}
{{ template "windows/logger.ps1" . }}
{{ template "windows/json_helpers.ps1" . }}

# Locate Windows Terminal packages and update LocalState\settings.json
$localAppData = [System.Environment]::GetFolderPath('LocalApplicationData')
$packagesDir = Join-Path $localAppData 'Packages'

if (-not (Test-Path $packagesDir)) {
	Write-ErrorLog "Packages directory not found: $packagesDir"
	exit 0
}

$candidates = Get-ChildItem -Path $packagesDir -Directory -ErrorAction SilentlyContinue | Where-Object {
	$_.Name -like 'Microsoft.WindowsTerminal*' -or $_.Name -like '*WindowsTerminal*'
}

if (-not $candidates -or $candidates.Count -eq 0) {
	Write-Host "No Windows Terminal package folders found under $packagesDir"
	exit 0
}

$defaultsJson = @'
{
	"alwaysOnTop": true,
	"autoHideWindow": true,
    "copyFormatting": "none",
	"copyOnSelect": false,
	"disableAnimations": true,
	"profiles":
	{
		"defaults":
		{
			"bellSound":
			[
				"False"
			],
            "bellStyle": "none",
            "colorScheme": "Dark+",
			"cursorShape": "filledBox",
			"font":
			{
				"face": "FiraCode Nerd Font Mono",
				"features":
				{
					"liga": 1
				},
				"size": 12
			},
            "opacity": 90,
			"padding": "0, 0, 0, 0",
            "scrollbarState": "hidden",
            "useAcrylic": true
		}
	}
}
'@

foreach ($pkg in $candidates) {
	$localState = Join-Path $pkg.FullName 'LocalState'
	$settingsPath = Join-Path $localState 'settings.json'

	if (-not (Test-Path $settingsPath)) {
		Write-Host "No settings.json at $settingsPath"
		continue
	}

	Write-Host "Updating Windows Terminal settings at: $settingsPath"
	try {
		$timestamp = (Get-Date).ToString('yyyyMMddHHmmss')
		$backupPath = "$settingsPath.bak.$timestamp"
		Copy-Item -Path $settingsPath -Destination $backupPath -Force

		$raw = Get-Content -Path $settingsPath -Raw -ErrorAction Stop
		$cleanJson = $raw -replace "(?m)^\s*//.*$",""
		$currentConfig = $cleanJson | ConvertFrom-Json
		$defaults = $defaultsJson | ConvertFrom-Json

		Merge-WindowsTerminalJSON -target $currentConfig -source $defaults

		$jsonString = $currentConfig | ConvertTo-Json -Depth 99
		$formatted = [System.Text.Json.JsonSerializer]::Serialize(
			[System.Text.Json.JsonDocument]::Parse($jsonString),
			[System.Text.Json.JsonSerializerOptions]@{ WriteIndented = $true }
		)

		$formatted | Set-Content -Path $settingsPath -Encoding UTF8
		Write-Host "Updated $settingsPath (backup at $backupPath)"
	}
	catch {
		Write-ErrorLog "Failed to update $settingsPath - $_"
	}
}


