#
# Install and configure the Quake Terminal GNOME Shell extension, which
# provides a Wayland-native drop-down Kitty terminal toggled via Alt+§.
#
#{{ template "install_helpers.sh" . }}

set -euo pipefail

readonly QUAKE_UUID='quake-terminal@diegodario88.github.io'
readonly QUAKE_SCHEMA='org.gnome.shell.extensions.quake-terminal'
readonly QUAKE_EXT_DIR="${HOME}/.local/share/gnome-shell/extensions/${QUAKE_UUID}"

# Wrapper: gsettings against the extension's local schema dir.
__qgs() {
  gsettings --schemadir "${QUAKE_EXT_DIR}/schemas" set "${QUAKE_SCHEMA}" "$@"
}

__cleanup_legacy_keybindings() {
  local media_keys='org.gnome.settings-daemon.plugins.media-keys'
  local current_list
  current_list=$(gsettings get "${media_keys}" custom-keybindings)

  for legacy_path in \
    '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/guake/' \
    '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/kitty-dropdown/'
  do
    if [[ "${current_list}" == *"${legacy_path}"* ]]; then
      current_list=$(printf '%s' "${current_list}" \
        | sed "s|, '${legacy_path}'||; s|'${legacy_path}', ||; s|'${legacy_path}'||")
      verbose_echo "Removed legacy keybinding: ${legacy_path}"
    fi
  done

  gsettings set "${media_keys}" custom-keybindings "${current_list}"
}

__install_quake_terminal() {
  if gnome-extensions list 2>/dev/null | grep -qxF "${QUAKE_UUID}"; then
    verbose_echo "Quake Terminal already installed"
    return
  fi

  local shell_ver
  shell_ver=$(gnome-shell --version 2>/dev/null | awk '{print $3}' | cut -d. -f1)
  if [[ -z "${shell_ver}" ]]; then
    log_error "Cannot determine GNOME Shell version; skipping Quake Terminal install"
    return 1
  fi

  local zip_file
  zip_file=$(mktemp --suffix=.zip)
  # shellcheck disable=SC2064
  trap "rm -f '${zip_file}'" RETURN

  downloadFile \
    "https://extensions.gnome.org/download-extension/${QUAKE_UUID}.shell-extension.zip?shell_version=${shell_ver}" \
    "${zip_file}" || { log_error "Failed to download Quake Terminal extension"; return 1; }

  gnome-extensions install --force "${zip_file}"
  verbose_echo "Installed Quake Terminal extension (GNOME Shell ${shell_ver})"
}

__configure_quake_terminal() {
  if [[ ! -d "${QUAKE_EXT_DIR}/schemas" ]]; then
    log_error "Quake Terminal schema dir not found after install: ${QUAKE_EXT_DIR}/schemas"
    return 1
  fi

  __qgs terminal-id     'kitty.desktop'
  __qgs toggle-shortcut "['<Alt>section']"
  __qgs vertical-size   100
  __qgs always-on-top   true
  verbose_echo "Configured Quake Terminal"
}

__enable_quake_terminal() {
  gnome-extensions enable "${QUAKE_UUID}" 2>/dev/null || true
}

if ! running_gnome; then
  verbose_echo "Skipping Quake Terminal setup, not running GNOME"
  exit 0
fi

if ! command -v gsettings >/dev/null 2>&1; then
  verbose_echo "Skipping Quake Terminal setup, gsettings not available"
  exit 0
fi

__cleanup_legacy_keybindings
__install_quake_terminal
__configure_quake_terminal
__enable_quake_terminal

# vim: set ft=bash shiftwidth=2 tabstop=2:
