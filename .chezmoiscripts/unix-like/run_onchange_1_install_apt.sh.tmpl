#{{ template "install_helpers.sh" . }}
#{{ template "install_helpers_apt.sh" . }}
#{{ template "install_helpers_snap.sh" . }}

# Required packages (log error if unavailable)
packages=(
#{{ template "package_list.tmpl" (dict "mgr" "apt" "optional" false "ctx" .) }}
)
apt_install "${packages[@]}"

# Optional packages (errors suppressed; may not be in all repo versions)
packages=(
#{{ template "package_list.tmpl" (dict "mgr" "apt" "optional" true "ctx" .) }}
)
apt_install 0 "${packages[@]}"

#{{ if ne .machineType "min" }}
# GNOME-specific packages (runtime check required)
packages=()
if running_gnome; then
  packages+=(guake gnome-tweaks)
  command -v dconf >/dev/null 2>&1 || packages+=(dconf-cli)
fi
apt_install 1 "${packages[@]}"

# Snap packages
packages=()
command -v tldr >/dev/null 2>&1 || packages+=(tldr)
snap_install "${packages[@]}"
#{{ end }}

