#{{ template "install_helpers.sh" . }}
#{{ template "install_helpers_dnf.sh" . }}

# Required packages (log error if unavailable)
packages=(
#{{ template "package_list.tmpl" (dict "mgr" "dnf" "optional" false "ctx" .) }}
)
dnf_install "${packages[@]}"

# Optional packages (errors suppressed)
packages=(
#{{ template "package_list.tmpl" (dict "mgr" "dnf" "optional" true "ctx" .) }}
)
dnf_install 0 "${packages[@]}"

#{{ if ne .machineType "min" }}
# GNOME-specific packages (runtime check required)
packages=()
if running_gnome; then
  packages+=(guake gnome-tweaks)
fi
dnf_install 1 "${packages[@]}"
#{{ end }}

