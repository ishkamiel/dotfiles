#{{ template "install_helpers.sh" . }}
#{{ template "install_helpers_dnf.sh" . }}

packages=(
  git
  neovim
  tmux
  vim-enhanced
  zsh
#{{ if ne .machineType "min" }}
  bat
  btop
  curl
  dconf
  direnv
  du-dust
  eza
  fd-find
  fzf
  git-crypt
  ipython3
  locate
  ripgrep
  shellcheck
  starship
  tldr
  wget2-wget
# Python stuff
  lbzip2
  lzma
  python-is-python3
  python3-pip
#{{ if .needBuildTools }}
  autoconf
  automake
  ccache
  clang
  clang-format
  cmake
  editorconfig
  ctags
  g++
  gcc
  flang
  libcriticism-perl
  libxml2-devel
  lld
  llvm
  make
  markdown
  markdown-cli
  markdownlint
  ninja-build
  pkg-config
  pre-commit
  pylint
  rbenv
  rustup
#{{ end }}
#{{ end }}
)
dnf_install "${packages[@]}"

packages=()

#{{ if ne .machineType "min" }}
if running_gnome; then
  packages+=(guake gnome-tweaks)
  command -v dconf >/dev/null 2>&1 || packages+=(dconf-cli)
fi
#{{ end }}

dnf_install 1 "${packages[@]}"

