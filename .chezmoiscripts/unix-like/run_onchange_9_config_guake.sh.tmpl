set -euo pipefail

__do_guake() {
  if ! running_gnome; then
    verbose_echo "Skipping Guake settings, not running Gnome"
    return
  fi

  if ! command -v guake >/dev/null 2>&1; then
    verbose_echo "Skipping Guake settings, guake not installed"
    return
  fi

  if ! command -v gsettings >/dev/null 2>&1; then
    verbose_echo "Skipping Guake settings, gsettings not available"
    return
  fi

  # --- Keyboard shortcuts ---
  # Global: toggle show/hide
  gsettings set org.guake.keybindings.global show-hide 'F12'
  # Local tab management
  gsettings set org.guake.keybindings.local new-tab '<Primary>t'
  gsettings set org.guake.keybindings.local close-tab '<Primary>w'
  gsettings set org.guake.keybindings.local next-tab '<Primary>Page_Down'
  gsettings set org.guake.keybindings.local previous-tab '<Primary>Page_Up'
  gsettings set org.guake.keybindings.local rename-current-tab '<Primary>F2'
  gsettings set org.guake.keybindings.local move-tab-left '<Primary><Shift>Page_Up'
  gsettings set org.guake.keybindings.local move-tab-right '<Primary><Shift>Page_Down'
  # Local splits
  gsettings set org.guake.keybindings.local split-tab-vertical '<Primary><Shift>e'
  gsettings set org.guake.keybindings.local split-tab-horizontal '<Primary><Shift>o'

  # --- Window dimensions ---
  # Height as percentage of screen (0-100)
  gsettings set org.guake window-height 50
  # Width as percentage of screen (0-100); 100 = full width
  gsettings set org.guake window-width 100
  # Horizontal alignment: 0=left, 1=center, 2=right
  gsettings set org.guake window-halignment 0
  # Keep on top
  gsettings set org.guake window-ontop true
  # Do not hide on focus loss (set true to auto-hide)
  gsettings set org.guake window-losefocus false

  # --- Tab / terminal appearance ---
  gsettings set org.guake.style use-default-font false
  gsettings set org.guake.style font 'Monospace 12'
  # Show/hide tab bar
  gsettings set org.guake show-tab-names true
  # Enable bold
  gsettings set org.guake.style.font allow-bold true

  # --- Color scheme: Solarized Dark ---
  # Foreground (base0 #839496), Background (base03 #002b36)
  gsettings set org.guake.style.font foreground-color '#839496'
  gsettings set org.guake.style.font background-color '#002b36'
  # 16-color palette: Solarized Dark
  # base02, red, green, yellow, blue, magenta, cyan, base2,
  # base03, orange, base01, base00, base0, violet, base1, base3
  gsettings set org.guake.style.font palette \
    '#073642:#dc322f:#859900:#b58900:#268bd2:#d33682:#2aa198:#eee8d5:#002b36:#cb4b16:#586e75:#657b83:#839496:#6c71c4:#93a1a1:#fdf6e3:#839496:#002b36'
  gsettings set org.guake.style.font palette-name 'Solarized Dark'

  # --- Miscellaneous ---
  gsettings set org.guake restore-tabs-notify false
  gsettings set org.guake restore-tabs-startup false
  gsettings set org.guake scroll-output true
  gsettings set org.guake history-size 4096
}

__do_guake

