#
# Patch Guake's notebook.py to disable the double-click-opens-new-tab behaviour.
# The upstream handler fires in the terminal content area when tmux mouse mode is
# active (Guake bugs #1697, #2249), causing tmux sessions to appear detached.
# Fix: change the height guard from < 60 to < 0 (always false).
#
#{{ template "install_helpers.sh" . }}

set -euo pipefail

__patch_guake_notebook() {
  if ! command -v guake >/dev/null 2>&1; then
    verbose_echo "Skipping Guake notebook patch, guake not installed"
    return
  fi

  local notebook_py
  notebook_py=$(python3 -c \
    "import guake, os; print(os.path.join(os.path.dirname(guake.__file__), 'notebook.py'))" \
    2>/dev/null) || {
    log_error "Could not locate guake/notebook.py via Python import"
    return
  }

  if [[ ! -f "${notebook_py}" ]]; then
    log_error "guake notebook.py not found at ${notebook_py}"
    return
  fi

  if grep -q 'get_height() < 60' "${notebook_py}"; then
    sudo sed -i 's/get_height() < 60/get_height() < 0/' "${notebook_py}"
    verbose_echo "Patched ${notebook_py}: disabled double-click new-tab"
  else
    verbose_echo "${notebook_py} already patched or pattern not found, skipping"
  fi
}

__patch_guake_notebook

