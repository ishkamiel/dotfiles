#{{ template "install_helpers.sh" . }}
#{{ template "install_helpers_cargo.sh" . }}

if ! command -v cargo >/dev/null 2>&1; then
  verbose_echo "cargo not found, skipping cargo package installs"
  exit 0
fi

# Required packages (log error if unavailable)
packages=(
#{{ template "package_list.tmpl" (dict "mgr" "cargo" "optional" false "ctx" .) }}
)
cargo_install "${packages[@]}"

# Optional packages (errors suppressed)
packages=(
#{{ template "package_list.tmpl" (dict "mgr" "cargo" "optional" true "ctx" .) }}
)
cargo_install 0 "${packages[@]}"

