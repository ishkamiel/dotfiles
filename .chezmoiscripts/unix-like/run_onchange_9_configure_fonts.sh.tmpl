#{{ template "install_helpers.sh" . }}
#{{ template "font_helpers.sh" . }}

set -euo pipefail

__configure_gnome_font() {
  if command -v dconf >/dev/null 2>&1; then
    local monospace_font
    monospace_font=$(__find_first_available_font "${monospace_fonts[@]}")

    if [[ -n "$monospace_font" ]]; then
      dconf write /org/gnome/desktop/interface/monospace-font-name "'${monospace_font}'"
    fi
  fi
}

__configure_kitty_font() {
  local kitty_conf_dir="${HOME}/.config/kitty"
  [[ -d "$kitty_conf_dir" ]] || return 0

  local monospace_font
  monospace_font=$(__find_first_available_font "${monospace_fonts[@]}")
  [[ -n "$monospace_font" ]] || return 0

  printf '# Generated by run_onchange_9_configure_fonts.sh — do not edit by hand\nfont_family %s\n' \
    "$monospace_font" > "${kitty_conf_dir}/font.conf"
  verbose_echo "Wrote kitty font: ${monospace_font}"
}

fc-cache -f "${HOME}/.local/share/fonts"
__configure_gnome_font
__configure_kitty_font

