[user]
    name = "${__ish_name}"
    email = "${__ish_email}"
[core]
    fsmonitor = true
    untrackedcache = true
    excludesfile = ~/.config/git/ignore
[init]
    defaultBranch = main
[pull]
    rebase = true
[push]
    autoSetupRemote = true
    default = simple
[fetch]
    prune = true
[rebase]
    autosquash = true
    autostash = true
[rerere]
    enabled = true
[branch]
    sort = -committerdate
[column]
    ui = auto
[diff]
    tool = vimdiff
    algorithm = histogram
[alias]
    co = checkout
    dname = diff --name-status
    dwords = diff --color-words
    fpush = push --force-with-lease
    lg = log --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(white)%s%C(reset) %C(bold green)(%ar)%C(reset) %C(cyan)<%an>%C(reset)%C(bold yellow)%d%C(reset)'
    whatchanged = log --raw --no-merges
[include]
    path = ~/.gitconfig_local
[submodule]
	fetchJobs = 8
